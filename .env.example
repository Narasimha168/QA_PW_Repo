# Copy to `.env` to point the suite at a different instance or to override
# credentials. Every value below is optional — the defaults target the public
# OrangeHRM demo described in the assessment brief.

BASE_URL=https://opensource-demo.orangehrmlive.com
ORANGEHRM_USERNAME=Admin
ORANGEHRM_PASSWORD=admin123

# Set to false to watch the run in a real browser window.
HEADLESS=true
